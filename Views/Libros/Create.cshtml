@model WebApplication2.Models.Libro

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Crear Libro";
}

<h1>Crear Libro</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">

        <label asp-for="Titulo"
               class="form-label">
            Título
        </label>

        <input asp-for="Titulo"
               class="form-control" />

        <span asp-validation-for="Titulo"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="AutorId"
               class="form-label">
            Autor
        </label>

        <select asp-for="AutorId"
                class="form-select"
                asp-items="ViewBag.AutorId">

            <option value="">
                -- Seleccione un autor --
            </option>

        </select>

        <span asp-validation-for="AutorId"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Guardar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>



