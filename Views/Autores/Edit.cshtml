@model WebApplication2.Models.Autor


@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Editar autor";
}

<h2>Editar autor</h2>

<form asp-action="Edit" method="post">

    <input type="hidden"
           asp-for="Id" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="Nombre"
               class="form-label">
            Nombre
        </label>

        <input asp-for="Nombre"
               class="form-control" />

        <span asp-validation-for="Nombre"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Guardar cambios
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>
