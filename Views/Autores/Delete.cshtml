@model WebApplication2.Models.Autor
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h1>Eliminar Autor</h1>

<h3>
    ¿Estás seguro de que deseas eliminar este autor?
</h3>

<div>

    <dl class="row">

        <dt class="col-sm-2">
            Nombre
        </dt>

        <dd class="col-sm-10">
            @Model.Nombre
        </dd>
    </dl>

    @if (Model.Libros.Any())
    {
        <div class="alert alert-warning">
            Este autor tiene
            <strong>@Model.Libros.Count</strong>
            libro(s) asociado(s).
            No podrá ser eliminado.
        </div>
    }
    else
    {
        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="Id" />

            <button type="submit"
                    class="btn btn-danger">
                Confirmar eliminación
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </form>
    }

</div>