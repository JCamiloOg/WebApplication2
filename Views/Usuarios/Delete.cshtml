@model WebApplication2.Models.Usuario
@{
    ViewData["Title"] = "Eliminar usuario";
}

<h2>Eliminar usuario</h2>

<div>
    <h4>¿Desea eliminar el siguiente usuario?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            <label>Id:</label>
        </dt>
        <dd class="col-sm-10">
            @Model.Id
        </dd>
        <dt class="col-sm-2">
            <label>Nombre:</label>
        </dt>
        <dd class="col-sm-10">
            @Model.Nombre
        </dd>
        <dt class="col-sm-2">
            <label>Tarjeta de biblioteca:</label>
        </dt>
        <dd class="col-sm-10">
            @Model.TarjetaBiblioteca.Codigo
        </dd>
       </dl>

    @if (Model.Prestamos.Any())
    {
        <div class="alert alert-warning">
            Este usuario tiene
            <strong>@Model.Prestamos.Count</strong>
            prestamo(s) asociado(s).
            No podrá ser eliminado.
        </div>
        <a asp-action="Index"
           class="btn btn-secondary mt-3">
            Volver
        </a>
    }
    else
    {
        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="Id" />

            <button type="submit"
                    class="btn btn-danger">
                Confirmar eliminación
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>
        </form>
    }
</div>

    