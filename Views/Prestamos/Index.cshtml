@model IEnumerable<WebApplication2.Models.Prestamo>

@{
    ViewData["Title"] = "Préstamos";
}

<h2>Préstamos</h2>
<a class="btn btn-primary mb-3" href="/Prestamos/Create">Registrar Préstamo</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Usuario</th>
            <th>Libro</th>
            <th>Fecha Préstamo</th>
            <th>Fecha Devolución</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var prestamo in Model)
        {
            <tr>
                <td>@prestamo.Id</td>
                <td>@prestamo.Usuario?.Nombre</td>
                <td>@prestamo.Libro?.Titulo</td>
                <td>@prestamo.FechaPrestamo.ToShortDateString()</td>
                <td>@(prestamo.FechaDevolucion?.ToShortDateString()  ?? "Pendiente")</td>
                <td>
                    <a class="btn btn-sm btn-warning" href="/Prestamos/Edit/@prestamo.Id">Editar</a>
                    <a class="btn btn-sm btn-danger" href="/Prestamos/Delete/@prestamo.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
