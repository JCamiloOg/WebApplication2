@model WebApplication2.Models.Prestamo;

@{
    ViewData["Title"] = "Editar Préstamo";
}

<h2>Editar Préstamo</h2>
<form asp-action="Edit" method="POST">
    <input type="hidden" ap-form="Id" />

    <div class="mb-3">
        <label>Usuario</label>
        <select asp-for="UsuarioId" asp-items="ViewBag.Usuarios" class="form-control"></select>
    </div>
    <div class="mb-3">
        <label>Libro</label>
        <select asp-for="LibroId" asp-items="ViewBag.Libros" class="form-control"></select>
    </div>
    <div class="mb-3">
        <label>Fecha Préstamo</label>
        <input asp-for="FechaPrestamo" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Fecha Devolución (opcional)</label>
        <input asp-for="FechaDevolucion" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-secondary" href="/Prestamos">Volver</a>
</form>
